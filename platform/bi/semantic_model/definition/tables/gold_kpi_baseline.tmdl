/// Frozen KPI baseline (Direct Lake table) — the stable reference for executive KPIs.
table gold_kpi_baseline
	lineageTag: novasteel-gold-kpi-baseline

	column site
		dataType: string
		sourceColumn: site

	column energyMwhPerTon
		dataType: double
		sourceColumn: energyMwhPerTon

	column co2KgPerTon
		dataType: double
		sourceColumn: co2KgPerTon

	column costEurPerTon
		dataType: double
		sourceColumn: costEurPerTon

	column highGradeYield
		dataType: double
		sourceColumn: highGradeYield

	partition gold_kpi_baseline = entity
		mode: directLake
		source
			entityName: gold_kpi_baseline
			expressionSource: DirectLakeSource
