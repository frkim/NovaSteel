**/bin/
**/obj/
**/out/
**/publish/

# IDE / tooling
**/.vs/
**/.vscode/
**/.idea/

# VCS
.git/
.gitignore

# Python caches
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/.venv/

# Node
**/node_modules/

# Local env / secrets
**/*.env
**/.DS_Store
